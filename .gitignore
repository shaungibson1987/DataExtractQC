# Ignore Python cache and compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore virtual environments
venv/
.env/

# Ignore output and build folders
dist/
build/

# Ignore data folder and its contents
data/

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore log files
*.log
error_log.txt

# Ignore Excel and CSV files (optional, remove if you want to track these)
*.xlsx
*.csv

# Ignore include.txt if you don't want to track it (remove this line if you do)
#include.txt
