# Ignore Python cache and compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore virtual environments
venv/
.env/

# Ignore output and build folders
dist/
build/

# Ignore data folder and its contents (case-insensitive)
[Dd]ata/
[Dd]ata/*

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore log files
*.log
error_log.txt
debug.log

# Ignore Excel and CSV files (sample data)
*.xlsx
*.csv
*.zip

# Ignore PyInstaller spec files (build artifacts)
*.spec

# Ignore user-specific files
words.txt
include.txt
P027822.xlsx

# Ignore generated documentation (keep source)
DataExtractQC_User_Guide.docx

# IDE files
.vscode/
.idea/
*.swp
*.swo
